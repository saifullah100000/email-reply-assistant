generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}


enum Role {
  USER
  ADMIN
}


model User {

  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role Role @default(USER)

  createdAt DateTime @default(now())

  emailReplies EmailReply[]

}



model EmailReply {

  id Int @id @default(autoincrement())

  subject String

  body String

  reply String

  category String

  createdAt DateTime @default(now())

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}